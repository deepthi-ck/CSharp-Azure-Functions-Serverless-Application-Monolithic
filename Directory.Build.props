<Project>
  <PropertyGroup>
    <!-- C#_net4.8: entire monolith uses this one Customer Version. -->
    <AppTargetFramework>net48</AppTargetFramework>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
    <CustomerVersion>4.8</CustomerVersion>
    <BranchName>C#_net4.8</BranchName>
    <Scenario>1 - Monolithic</Scenario>
    <ModuleLayout>flat (single module)</ModuleLayout>
    <ProjectTypeName>Azure Functions Serverless Application</ProjectTypeName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
